{
  "build": {
    "arduino": {
      "ldscript": "nrf52840_s140_v6.ld"
    },
    "core": "nRF5",
    "cpu": "cortex-m4",
    "extra_flags": "-DARDUINO_NRF52840_PROMICRO -DNRF52840_XXAA -DCONFIG_NFCT_PINS_AS_GPIOS",
    "f_cpu": "64000000L",
    "hwids": [
      ["0x239A", "0x0029"],
      ["0x239A", "0x8029"],
      ["0x239A", "0x002A"],
      ["0x239A", "0x802A"],
      ["0x1915", "0x520F"]
    ],
    "usb_product": "ProMicro nRF52840",
    "mcu": "nrf52840",
    "variant": "promicro_nrf52840",
    "variants_dir": "boards/variants",
    "bsp": {
      "name": "adafruit"
    },
    "softdevice": {
      "sd_flags": "-DS140",
      "sd_name": "s140",
      "sd_version": "6.1.1",
      "sd_fwid": "0x00B6"
    },
    "bootloader": {
      "settings_addr": "0xFF000"
    }
  },
  "connectivity": ["bluetooth"],
  "debug": {
    "jlink_device": "nRF52840_xxAA",
    "svd_path": "nrf52840.svd",
    "openocd_target": "nrf52.cfg"
  },
  "frameworks": ["arduino"],
  "name": "ProMicro nRF52840 (V1940 / nice!nano v2 compatible)",
  "upload": {
    "maximum_ram_size": 237568,
    "maximum_size": 815104,
    "speed": 115200,
    "protocol": "nrfutil",
    "protocols": ["nrfutil", "jlink", "nrfjprog", "stlink", "cmsis-dap", "blackmagic"],
    "use_1200bps_touch": true,
    "require_upload_port": true,
    "wait_for_upload_port": true
  },
  "url": "https://nicekeyboards.com/nice-nano",
  "vendor": "Generic"
}
